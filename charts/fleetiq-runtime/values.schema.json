{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Closed D04 package input contract. No credentials, arbitrary commands or migration hooks. Nonlocal sizing is not production acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "maintenance",
    "imagePullSecrets",
    "public",
    "gateway",
    "backend",
    "edge",
    "network",
    "analytics"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["local", "nonlocal"]
    },
    "maintenance": {
      "type": "boolean"
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]([a-z0-9-]*[a-z0-9])?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "certificateSecret", "listenerPort", "ingressMode"],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "certificateSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "listenerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ingressMode": {
          "type": "string",
          "enum": ["pod-selector", "cilium"]
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "databaseSecret",
        "databaseTrust",
        "oidc",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "databaseSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-zA-Z0-9._-]+$"
            }
          }
        },
        "databaseTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-zA-Z0-9._-]+$"
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "clientId",
            "authority",
            "clientSecret",
            "additionalTrust"
          ],
          "properties": {
            "issuer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^https://[^\\s@?#]+$"
            },
            "clientId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\s]+$"
            },
            "authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "clientSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-zA-Z0-9._-]+$"
                }
              }
            },
            "additionalTrust": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-zA-Z0-9._-]+$"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^([1-9][0-9]*m?|0\\.[0-9]*[1-9][0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^([1-9][0-9]*m?|0\\.[0-9]*[1-9][0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "replicas", "resources"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^([1-9][0-9]*m?|0\\.[0-9]*[1-9][0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpu", "memory"],
              "properties": {
                "cpu": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^([1-9][0-9]*m?|0\\.[0-9]*[1-9][0-9]*)$"
                },
                "memory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16,
                  "pattern": "^[1-9][0-9]*(Mi|Gi)$"
                }
              }
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "databaseNamespace",
        "databaseCluster",
        "dnsNamespace",
        "dnsPodLabels",
        "oidcCidrs"
      ],
      "properties": {
        "databaseNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "databaseCluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "gatewayNamespace": {
          "type": "string",
          "minLength": 0,
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "gatewayPodLabels": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-zA-Z0-9./_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?$"
          }
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "dnsPodLabels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-zA-Z0-9./_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?$"
          }
        },
        "oidcCidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18,
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([1-9]|[12][0-9]|3[0-2])$"
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "alertmanager"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "alertmanager": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image", "configurationSecret", "receiverCidrs"],
          "properties": {
            "image": {
              "const": "prom/alertmanager:v0.34.2@sha256:39d8bb3966c694a124428a3a88fbcffd40bd069129ecd47c059f8a3f17c55f3b"
            },
            "configurationSecret": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "receiverCidrs": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:1[6-9]|2[0-9]|3[0-2])$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "alertmanager": {
                "properties": {
                  "configurationSecret": {
                    "minLength": 1
                  },
                  "receiverCidrs": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "nonlocal"
          }
        }
      },
      "then": {
        "properties": {
          "backend": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            }
          },
          "edge": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "gateway": {
            "properties": {
              "ingressMode": {
                "const": "pod-selector"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "network": {
            "required": ["gatewayNamespace", "gatewayPodLabels"],
            "properties": {
              "gatewayNamespace": {
                "minLength": 1
              },
              "gatewayPodLabels": {
                "minProperties": 1
              }
            }
          }
        }
      }
    }
  ]
}
