{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Closed D04 package input contract. No credentials, arbitrary commands or migration hooks. Nonlocal sizing is not production acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "clusterName",
    "image",
    "instances",
    "storage",
    "database",
    "owner",
    "resources"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["local", "nonlocal", "minimal-demo-candidate", "minimal-demo-install"]
    },
    "clusterName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+:[1-9][0-9]*\\.[0-9]+(-[a-z0-9.-]+)?@sha256:[a-f0-9]{64}$",
      "description": "CNPG derives the PostgreSQL version from this tag; the required digest remains the immutable artifact identity."
    },
    "instances": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "size"],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "pattern": "^[1-9][0-9]*Gi$"
        }
      }
    },
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "passwordSecret"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "passwordSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "passwordSecret"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "passwordSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^([1-9][0-9]*m?|0\\.[0-9]*[1-9][0-9]*)$"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^([1-9][0-9]*m?|0\\.[0-9]*[1-9][0-9]*)$"
            },
            "memory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16,
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            }
          }
        }
      }
    },
    "managedRoles": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "ensure",
          "login",
          "superuser",
          "createdb",
          "createrole",
          "replication",
          "bypassrls",
          "inherit",
          "inRoles"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^fleetiq_[a-z_]+$" },
          "ensure": { "const": "present" },
          "login": { "type": "boolean" },
          "superuser": { "const": false },
          "createdb": { "const": false },
          "createrole": { "const": false },
          "replication": { "const": false },
          "bypassrls": { "const": false },
          "inherit": { "const": false },
          "inRoles": { "const": [] },
          "connectionLimit": { "const": -1 },
          "disablePassword": { "const": true },
          "passwordSecret": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "pattern": "^fleetiq-db-[a-z-]+$" }
            }
          }
        },
        "if": { "properties": { "login": { "const": true } } },
        "then": {
          "required": ["passwordSecret"],
          "not": { "required": ["disablePassword"] }
        },
        "else": {
          "required": ["disablePassword"],
          "not": { "required": ["passwordSecret"] }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeNamespace",
        "backendName",
        "operatorNamespace",
        "operatorPodLabels",
        "dnsNamespace",
        "dnsPodLabels",
        "apiServerCidr",
        "apiServerPort"
      ],
      "properties": {
        "runtimeNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "backendName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "operatorNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "operatorPodLabels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-zA-Z0-9./_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?$"
          }
        },
        "dnsNamespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "dnsPodLabels": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-zA-Z0-9./_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?$"
          }
        },
        "apiServerCidr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18,
          "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([1-9]|[12][0-9]|3[0-2])$"
        },
        "apiServerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "analyticsEnabled": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": { "const": "minimal-demo-candidate" }
        }
      },
      "then": {
        "not": {
          "anyOf": [{ "required": ["runtime"] }, { "required": ["network"] }]
        },
        "properties": {
          "clusterName": { "const": "fleetiq-db" },
          "image": {
            "const": "registry.invalid/candidate/postgresql:18.4-system-trixie@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
          },
          "instances": { "const": 1 },
          "storage": { "const": { "className": "local-retained", "size": "4Gi" } },
          "database": { "const": "fleetiq" },
          "owner": {
            "const": {
              "role": "fleetiq_migrator",
              "passwordSecret": "offline-candidate-migration-owner"
            }
          },
          "resources": {
            "const": {
              "requests": { "cpu": "200m", "memory": "256Mi" },
              "limits": { "cpu": "1", "memory": "768Mi" }
            }
          }
        }
      },
      "else": {
        "if": { "properties": { "profile": { "const": "minimal-demo-install" } } },
        "then": {
          "required": ["managedRoles"],
          "not": {
            "anyOf": [{ "required": ["runtime"] }, { "required": ["network"] }]
          },
          "properties": {
            "clusterName": { "const": "fleetiq-db" },
            "image": { "pattern": "^ghcr\\.io/cloudnative-pg/postgresql:18\\.[0-9]+-" },
            "instances": { "const": 1 },
            "database": { "const": "fleetiq" },
            "owner": {
              "const": {
                "role": "fleetiq_migrator",
                "passwordSecret": "fleetiq-db-migrator"
              }
            },
            "storage": { "const": { "className": "local-retained", "size": "4Gi" } },
            "resources": {
              "const": {
                "requests": { "cpu": "200m", "memory": "256Mi" },
                "limits": { "cpu": "1", "memory": "768Mi" }
              }
            }
          }
        },
        "else": {
          "required": ["runtime", "network"],
          "not": { "required": ["managedRoles"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "nonlocal"
          }
        }
      },
      "then": {
        "properties": {
          "instances": {
            "minimum": 3
          }
        }
      }
    }
  ]
}
