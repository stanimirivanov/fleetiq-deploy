{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation"],
  "properties": {
    "operation": { "enum": ["bootstrap", "bootstrap-route", "migration-route"] },
    "attempt": { "type": "string", "pattern": "^demo-launch-[a-f0-9]{24}$" },
    "backend": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "bootstrap" } } },
      "then": { "required": ["backend"] },
      "else": { "not": { "required": ["backend"] } }
    },
    {
      "if": { "properties": { "operation": { "const": "bootstrap-route" } } },
      "then": { "required": ["attempt"] },
      "else": { "not": { "required": ["attempt"] } }
    }
  ]
}
